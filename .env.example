COINDCX_API_KEY=your_key_here
COINDCX_API_SECRET=your_secret_here

# Public candle/orderbook pair uses CoinDCX public pair format.
COINDCX_PUBLIC_PAIR=B-BTC_USDT

# Private order market uses CoinDCX spot market format.
COINDCX_TRADING_MARKET=BTCUSDT

CANDLE_INTERVAL=5m
CANDLE_LIMIT=100
MAX_QUOTE_PER_ORDER=10
MIN_CONFIDENCE=0.60
QUANTITY_STEP=0.000001
PRICE_STEP=0.01
STOP_LOSS_PERCENT=1.50
TAKE_PROFIT_PERCENT=3.00
MONITOR_POLL_SECONDS=15
LOOP_SLEEP_SECONDS=300
MAX_CANDLE_AGE_SECONDS=900
SIGNAL_LOG_PATH=signals.csv

# Notification options: none, actionable, all
# - none: no SMS/email
# - actionable: notify only when the bot plans/sends an order
# - all: notify every HOLD/BUY/SELL signal
NOTIFY_ON=none
NOTIFICATION_VERBOSE=false

# Twilio SMS settings. Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

# SMTP email settings. Leave blank to disable email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Keep false until you have paper-tested and reviewed the code.
LIVE_TRADING=false
